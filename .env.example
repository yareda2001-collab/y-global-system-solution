# Copy this file to .env and replace placeholders with your own values.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=replace-with-your-google-oauth-redirect-uri

# These retain the legacy database settings in config.php.
APP_DB_HOST=your-application-database-host
APP_DB_NAME=your-application-database-name
APP_DB_USER=your-application-database-user
APP_DB_PASS=replace-with-your-application-database-password

# Database settings used by the current admin configuration.
ADMIN_DB_HOST=replace-with-your-admin-database-host
ADMIN_DB_NAME=replace-with-your-admin-database-name
ADMIN_DB_USER=replace-with-your-admin-database-user
ADMIN_DB_PASS=replace-with-your-admin-database-password

# The application's active MySQL connections use these settings.
APP_DB_PROFILE=local
LOCAL_DB_HOST=replace-with-your-local-database-host
LOCAL_DB_NAME=replace-with-your-local-database-name
LOCAL_DB_USER=replace-with-your-local-database-user
LOCAL_DB_PASS=replace-with-your-local-database-password

# Used by admin/connect1.php when APP_DB_PROFILE=hosting.
HOSTING_DB_HOST=replace-with-your-hosting-database-host
HOSTING_DB_NAME=replace-with-your-hosting-database-name
HOSTING_DB_USER=replace-with-your-hosting-database-user
HOSTING_DB_PASS=replace-with-your-hosting-database-password
